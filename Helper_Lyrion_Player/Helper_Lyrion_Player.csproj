<?xml version="1.0" encoding="utf-8"?>
<!--
  Helper_Lyrion_Player - Driver 3 of the four-driver Lyrion architecture.
  Per-room rich UI extension device (RAD AExtensionDevice, DeviceType
  "Media Player", IsExtensionDevice=true). Hosts the Crestron Home
  now-playing UI for one Lyrion player: metadata, transport, shuffle,
  repeat, power. Bound by MAC address; consumes the Lyrion Server service.
  Never connects to LMS.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LyrionCommunity.Crestron.Lyrion.Helper</RootNamespace>
    <AssemblyName>Helper_Lyrion_Player</AssemblyName>
    <TargetFramework>net472</TargetFramework>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <CrestronSdkPath Condition=" '$(CrestronSdkPath)' == '' ">C:\Lyrion4Crestron\Crestron_SDK</CrestronSdkPath>

    <FileAlignment>512</FileAlignment>
    <Deterministic>false</Deterministic>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>

    <LangVersion>7.3</LangVersion>

    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <!--
    RAD framework references. The Helper driver is a RAD extension device
    (AExtensionDevice from RADCommon), so it only needs RADCommon and
    RADProTransports (plus Crestron.DeviceDrivers.API).
  -->
  <ItemGroup>
    <Reference Include="RADCommon">
      <HintPath>$(CrestronSdkPath)\Libraries\RADCommon.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
    <Reference Include="RADProTransports">
      <HintPath>$(CrestronSdkPath)\Libraries\RADProTransports.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
    <Reference Include="Crestron.DeviceDrivers.API">
      <HintPath>$(CrestronSdkPath)\Libraries\Crestron.DeviceDrivers.API.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!--
    Lyrion_Common.dll is shared by all four drivers. RAD drivers have no
    DriverAssemblyEntryPoint to hook AssemblyResolve, so it is bundled into
    the package as a plain dependency (declared in Driver.json's
    CrestronSerialDeviceApi.Dependencies) rather than embedded. The project
    reference copies it into the output directory for ManifestUtil to pick up.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Common\Lyrion_Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Driver.json">
      <LogicalName>$(AssemblyName).json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    UiDefinition.xml is copied to IncludeInPkg/UiDefinitions/ in the output
    directory so ManifestUtil bundles it into the .pkg package.
  -->
  <ItemGroup>
    <Content Include="IncludeInPkg\UiDefinitions\UiDefinition.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateCrestronSdk" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(CrestronSdkPath)\Libraries\Crestron.DeviceDrivers.SDK.dll')"
      Text="Crestron SDK not found at '$(CrestronSdkPath)\Libraries'. Install the Crestron Certified Drivers SDK or set the CrestronSdkPath environment variable (or pass /p:CrestronSdkPath=... on the command line)." />
  </Target>

  <Target Name="RunManifestUtil" AfterTargets="Build"
          Condition="Exists('$(CrestronSdkPath)\ManifestUtil\ManifestUtil.exe')">
    <Message Importance="high" Text="ManifestUtil: generating driver package for $(AssemblyName)..." />

    <Copy SourceFiles="$(CrestronSdkPath)\ManifestUtil\ManifestUtil.exe"
          DestinationFolder="$(TargetDir)"
          OverwriteReadOnlyFiles="true" />

    <Delete Files="$(TargetDir)$(AssemblyName).pkg" />

    <Exec Command="ManifestUtil.exe"
          WorkingDirectory="$(TargetDir)"
          IgnoreExitCode="true" />

    <Delete Files="$(TargetDir)ManifestUtil.exe" />

    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pkg')"
           Text="ManifestUtil.exe did not produce $(AssemblyName).pkg." />

    <Message Importance="high" Text="ManifestUtil: produced $(TargetDir)$(AssemblyName).pkg" />
  </Target>

  <Target Name="WarnIfManifestUtilMissing" AfterTargets="Build"
          Condition="!Exists('$(CrestronSdkPath)\ManifestUtil\ManifestUtil.exe')">
    <Warning Text="ManifestUtil.exe not found at '$(CrestronSdkPath)\ManifestUtil\ManifestUtil.exe'." />
  </Target>

</Project>
