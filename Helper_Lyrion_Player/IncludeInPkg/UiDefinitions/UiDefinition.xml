<?xml version="1.0" encoding="UTF-8" ?>
<uidefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://prd-use-rad-assets.azurewebsites.net/ExtensionsSchemaDefinition_v1_0.xsd">
  <version ver="1.0"/>

  <!-- Tile tap toggles POWER (primary icon + status reflect on/off); the
       playback STATE stays visible via the secondary icon — PlaybackStateIcon,
       a play glyph while playing and a pause glyph otherwise. Not
       PlaybackIcon: that is the Play/Pause button's NEXT-action affordance
       (pause while playing), and binding it here showed a pause symbol on a
       playing room (1.0.13 and earlier). Play/Pause and the rest of the
       transport live in the NowPlaying layout below. -->
  <tile icon="{PowerIcon}" secondaryicon="{PlaybackStateIcon}" status="{TileStatus}" action="command:PowerToggle" navigation="show:NowPlaying" showinhomepage="#false" showinroompage="#true"/>

  <layouts>

    <!--
      LAYOUT RULES - all observed on real hardware (a Crestron Home phone
      client). The schema URL above is dead and Crestron Home, not the SDK,
      interprets this file, so these are empirical and easy to break:

        1. A buttongroup holds at most FIVE buttons. A six-button group does
           not render at all - the whole row silently vanishes; it does not
           wrap, scroll, or truncate. This is why power/transport/modes are
           split across two rows rather than combined into one.
        2. An icon and a label COMPETE for the same button width, and what
           happens when both are set depends on how many buttons share the row:
             - at THREE or FOUR across the label is shown and TRUNCATED -
               icon="#icPlus" label="Vol +" rendered as "+  V...";
             - at FIVE across the label is dropped entirely and only the icon
               shows, which is why the playback row below can keep its labels
               harmlessly.
           So at three or four across, set an icon OR a label, never both; at
           five across the icon has to carry the button by itself.
        3. At two buttons across, an icon and a label both fit comfortably.
        4. A buttongroup / segmentedslider / buttongroup "flanked" controlgroup
           does not lay out on one line - it stacks, orphaning the trailing
           button in a card of its own.

      Every control is a fixed-height card and there is no padding or sizing
      control, so vertical space is bought only by using fewer controls.
      Before adding anything here, check what it displaces.
    -->
    <layout id="NowPlaying" isdefaultlayout="#true">
      <controls>

        <!-- Source name header (top of screen). -->
        <subheader id="SourceHeader" label="{SourceName}"/>

        <!-- Track card. Carries the timing on its fourth line rather than in a
             card of its own. {TimeText} is already duration-aware: it reads
             "00:29 / 02:54" when the duration is known and "00:29" alone for a
             radio stream, so no separate no-duration control is needed. -->
        <textdisplay id="TrackInfo" title="{TrackLine}" line1label="{ByArtist}" line2label="{FromAlbum}" line3label="{TimeText}"/>

        <!-- Playback row: exactly five buttons, all icon-driven. Five is the
             one width proven to render (rule 1), so treat it as a hard ceiling.
             Labels are retained for accessibility and narrower renderings; at
             five across only the icons show, and every icon here is either
             state-reflecting or self-evident. -->
        <buttongroup>
          <button id="RepeatBtn" label="Repeat" action="command:ToggleRepeat" icon="{RepeatIcon}"/>
          <button id="PrevBtn" label="Previous" action="command:Previous" icon="#icPrevious"/>
          <button id="PlayBtn" label="Play/Pause" action="command:TogglePlay" icon="{PlaybackIcon}"/>
          <button id="NextBtn" label="Next" action="command:Next" icon="#icNext"/>
          <button id="ShuffleBtn" label="Shuffle" action="command:ToggleShuffle" icon="{ShuffleIcon}"/>
        </buttongroup>

        <!-- Power + volume row: four across, so rule 2 applies and no button
             here may carry both an icon and a label.
               * Power is icon-only. The glyph is state-reflecting
                 (icPowerRegular / icPowerDisabled) and universally read, so it
                 stands on its own without a caption.
               * Vol -, Mute and Vol + are label-only. Dropping the +/- icons is
                 precisely what stops "Vol +" truncating to "V..." - those icons
                 were decorative while the text is the affordance. Mute has no
                 dependable glyph in the Crestron set in any case, and its label
                 doubles as the state readout (Mute / Unmute). -->
        <buttongroup>
          <button id="PowerBtn" action="command:PowerToggle" icon="{PowerIcon}"/>
          <button id="VolDownBtn" label="Vol -" action="command:VolumeDown"/>
          <button id="MuteBtn" label="{MuteLabel}" action="command:ToggleMute"/>
          <button id="VolUpBtn" label="Vol +" action="command:VolumeUp"/>
        </buttongroup>

        <!-- The read-only volume level bar has been removed: a full-height card
             to draw one thin, unadjustable line. Room volume lives on the
             Receiver (or the room's own volume control), and Vol -/+ above step
             it by the Receiver's configured amount. The SupportsVolume property
             is still published, just no longer drawn. -->

        <!-- Presets: up to four installer-configured shortcuts (Name|Icon|Command
             user attributes on this driver). Two per row - the width at which an
             icon and a label both fit (rule 3), so a preset name stays readable
             beside its icon. Keep names short; a long one truncates.

             Each button disappears when its slot is empty or unparseable, and
             the whole section hides when no slot is configured, so a room that
             uses none of them looks exactly as it did before. The same four
             actions are also exposed to Crestron Home sequences via
             [ProgrammableOperation] on HelperDriver. -->
        <subheader id="PresetHeader" label="Presets" visible="{AnyPresets}"/>
        <buttongroup>
          <button id="Preset1Btn" label="{PresetLabel1}" action="command:Preset1" icon="{PresetIcon1}" visible="{PresetVisible1}"/>
          <button id="Preset2Btn" label="{PresetLabel2}" action="command:Preset2" icon="{PresetIcon2}" visible="{PresetVisible2}"/>
        </buttongroup>
        <buttongroup>
          <button id="Preset3Btn" label="{PresetLabel3}" action="command:Preset3" icon="{PresetIcon3}" visible="{PresetVisible3}"/>
          <button id="Preset4Btn" label="{PresetLabel4}" action="command:Preset4" icon="{PresetIcon4}" visible="{PresetVisible4}"/>
        </buttongroup>

      </controls>
    </layout>

  </layouts>

  <alerts>
  </alerts>

</uidefinition>
