<?xml version="1.0" encoding="UTF-8" ?>
<uidefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://prd-use-rad-assets.azurewebsites.net/ExtensionsSchemaDefinition_v1_0.xsd">
  <version ver="1.0"/>

  <!-- Tile tap toggles POWER (primary icon + status reflect on/off); the
       playback state stays visible via the secondary icon. Play/Pause and the
       rest of the transport live in the NowPlaying layout below. -->
  <tile icon="{PowerIcon}" secondaryicon="{PlaybackIcon}" status="{TileStatus}" action="command:PowerToggle" navigation="show:NowPlaying" showinhomepage="#false" showinroompage="#true"/>

  <layouts>

    <layout id="NowPlaying" isdefaultlayout="#true">
      <controls>

        <!-- Source name header (top of screen). -->
        <subheader id="SourceHeader" label="{SourceName}"/>

        <!-- Track line (bold-ish title) + "by artist" / "from album". -->
        <textdisplay id="TrackInfo" title="{TrackLine}" line1label="{ByArtist}" line2label="{FromAlbum}"/>

        <!-- Read-only progress bar, then the elapsed/total time below it.
             Both hide when duration is unknown (e.g. radio streams). -->
        <segmentedslider id="Progress" label="" value="{Progress}" enabled="#false" visible="{HasDuration}"/>
        <textdisplay id="TimeInfo" title="{TimeText}" visible="{HasDuration}"/>

        <!-- Duration unknown: show elapsed time alone. -->
        <textdisplay id="ElapsedOnly" title="{Elapsed}" visible="{NoDuration}"/>

        <!-- Dedicated power control, kept apart from the transport row so it
             can't be mistaken for Play/Pause. Toggles the player's power. -->
        <buttongroup>
          <button id="PowerBtn" label="Power" action="command:PowerToggle" icon="{PowerIcon}"/>
        </buttongroup>

        <!-- Transport: Repeat | Previous | Play/Pause | Next | Shuffle. -->
        <buttongroup>
          <button id="RepeatBtn" label="Repeat" action="command:ToggleRepeat" icon="{RepeatIcon}"/>
          <button id="PrevBtn" label="Previous" action="command:Previous" icon="#icPrevious"/>
          <button id="PlayBtn" label="Play/Pause" action="command:TogglePlay" icon="{PlaybackIcon}"/>
          <button id="NextBtn" label="Next" action="command:Next" icon="#icNext"/>
          <button id="ShuffleBtn" label="Shuffle" action="command:ToggleShuffle" icon="{ShuffleIcon}"/>
        </buttongroup>

        <!-- Volume: [Mute][Vol-] | read-only level bar | [Vol+]. The bar is a
             gauge only (the extension UI has no adjustable slider, same as the
             progress bar); the buttons change volume by the Receiver's
             configured step. The bar hides for players with no mixer. -->
        <controlgroup>
          <buttongroup>
            <button id="MuteBtn" label="{MuteLabel}" action="command:ToggleMute"/>
            <button id="VolDownBtn" label="Vol -" action="command:VolumeDown" icon="#icMinus"/>
          </buttongroup>
          <segmentedslider id="Volume" label="" value="{Volume}" enabled="#false" visible="{SupportsVolume}"/>
          <buttongroup>
            <button id="VolUpBtn" label="Vol +" action="command:VolumeUp" icon="#icPlus"/>
          </buttongroup>
        </controlgroup>

        <!-- FALLBACK LAYOUT (swap in for the controlgroup above if Crestron Home
             rejects the flanked structure and the Helper page fails to load):
             level bar first, then all three buttons grouped after it.
        <controlgroup>
          <segmentedslider id="Volume" label="" value="{Volume}" enabled="#false" visible="{SupportsVolume}"/>
          <buttongroup>
            <button id="MuteBtn" label="{MuteLabel}" action="command:ToggleMute"/>
            <button id="VolDownBtn" label="Vol -" action="command:VolumeDown" icon="#icMinus"/>
            <button id="VolUpBtn" label="Vol +" action="command:VolumeUp" icon="#icPlus"/>
          </buttongroup>
        </controlgroup>
        -->

      </controls>
    </layout>

  </layouts>

  <alerts>
  </alerts>

</uidefinition>
